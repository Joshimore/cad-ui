# python
.venv/
__pycache__/
*.pyc

# runtime state (isolated mode: the repo itself is the workspace)
.cad-ui/

# team work stays local — commit the empty folder only, never its projects/tasks
Working directory/*
!Working directory/.gitkeep

# knowledge base is a shared empty skeleton — cards stay local, same model as above
knowledge-base/*
!knowledge-base/.gitkeep

# personal config — webhooks and local paths must never reach the shared repo
workspace.config.json

# local Claude Code settings (agents/skills in .claude/ ARE committed)
.claude/settings.local.json

# local dev logs — session/architecture notes stay on the author's machine
app/dev/
